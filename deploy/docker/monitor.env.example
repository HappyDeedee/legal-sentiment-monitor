MONITOR_HOST=0.0.0.0
MONITOR_PORT=8080
MONITOR_DATA_DIR=/app/monitor_data
MONITOR_BROWSER_DATA_DIR=/app/browser_data
MONITOR_ACCOUNT_PROFILE_ROOT=/app/monitor_data/account_profiles

# Leave empty to use the Playwright Chromium installed in the image.
MONITOR_BROWSER_EXECUTABLE=
MONITOR_BROWSER_COOKIE_SYNC_ENABLED=false
# Required before using an account-bound proxy; must return {"region":"..."}.
MONITOR_BROWSER_PROXY_PROBE_URL=
MONITOR_BROWSER_PROXY_PROBE_TIMEOUT_MS=30000

# Replace these before using a shared or public machine.
MONITOR_ADMIN_EMAIL=admin@example.com
MONITOR_ADMIN_PASSWORD=change-me-before-deploy
MONITOR_ADMIN_DISPLAY_NAME=System Administrator

# Server-like login behavior.
MONITOR_LOGIN_QR_HEADLESS=true
MONITOR_ALLOW_LOCAL_LOGIN_WINDOW=false
MONITOR_CRAWLER_HEADLESS=true
MONITOR_CDP_CONNECT_EXISTING=false

# Conservative first-run defaults. Enable scheduler/AI only when ready to run real tasks.
MONITOR_DISABLE_SCHEDULER=true
MONITOR_SKIP_AI_API=true

MONITOR_LOGIN_QR_TIMEOUT_MS=20000
MONITOR_LOGIN_QR_TIMEOUT_SECONDS=20
MONITOR_LOGIN_QR_TTL_SECONDS=600
MONITOR_GLOBAL_CRAWL_CONCURRENCY=2
MONITOR_PLATFORM_CONCURRENCY_DY=1
MONITOR_PLATFORM_CONCURRENCY_KS=1
MONITOR_PLATFORM_CONCURRENCY_XHS=1
MONITOR_CRAWLER_TIMEOUT_SECONDS=900
MONITOR_LOCK_CLEANUP_BUFFER_SECONDS=300
MONITOR_CRAWLER_MAX_RETRIES=1
MONITOR_CRAWLER_RETRY_DELAY_SECONDS=3
MONITOR_SCHEDULER_TICK_SECONDS=60
MONITOR_RUN_LOG_RETENTION_DAYS=90
MONITOR_REPORT_RETENTION_DAYS=180
MONITOR_JOB_LOCK_TTL_SECONDS=21600
